{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HOST gate record (MC-27)",
  "type": "object",
  "required": ["schema", "gate", "sha", "mode", "python", "platform", "results", "status"],
  "properties": {
    "schema": {"type": "integer", "const": 1},
    "gate": {"type": "string"},
    "sha": {"type": "string"},
    "mode": {"type": "string", "enum": ["run", "preflight"]},
    "python": {"type": "string"},
    "platform": {"type": "string"},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nodeid", "outcome"],
        "properties": {
          "nodeid": {"type": "string"},
          "outcome": {"type": "string"},
          "labels": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "engine": {
      "type": ["string", "object"],
      "properties": {
        "cli_path": {"type": "string"},
        "endpoint": {"type": ["string", "null"]},
        "server_version": {"type": ["string", "null"]},
        "reachable_before": {"type": "boolean"},
        "reachable_after": {"type": "boolean"},
        "reason": {"type": "string"}
      }
    },
    "images": {
      "type": ["array", "object"],
      "items": {"type": "string"},
      "additionalProperties": {"type": "string"}
    },
    "inventory_before": {"type": ["array", "object"]},
    "inventory_after": {"type": ["array", "object"]},
    "diff": {
      "type": ["array", "object"],
      "properties": {
        "unattributed": {"type": "array"},
        "engine_state_changed": {"type": "boolean"}
      }
    },
    "residue": {"type": "array"},
    "status": {"type": "string", "enum": ["PASSED", "FAILED", "PRECONDITION_UNMET"]}
  },
  "additionalProperties": false
}
